{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coaching_draft_v1.json",
  "title": "CoachingDraft v1",
  "description": "Output from Smart Guitar AI Coach. Contains constructive feedback without PII.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "kind", "model", "template", "feedback"],

  "properties": {
    "schema_id": {
      "const": "coaching_draft_v1"
    },
    "schema_version": {
      "const": "v1"
    },
    "kind": {
      "type": "string",
      "enum": ["groove_feedback", "practice_summary", "technique_hint", "repertoire_suggest"]
    },

    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "runtime": { "const": "local" }
      }
    },

    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },

    "feedback": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "Constructive feedback items",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "text", "evidence_refs"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["strength", "focus_area", "tip", "encouragement"],
            "description": "Feedback category"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Constructive feedback text. Must be encouraging, not judgmental."
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "description": "References to evidence that supports this feedback",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric"],
              "properties": {
                "metric": { "type": "string", "minLength": 1 },
                "value": { "type": "number" }
              }
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Priority level (1=highest)"
          }
        }
      }
    },

    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "Brief session summary (optional)"
    },

    "next_focus": {
      "type": "object",
      "additionalProperties": false,
      "description": "Suggested focus for next session",
      "properties": {
        "area": {
          "type": "string",
          "description": "Area to focus on"
        },
        "reason": {
          "type": "string",
          "description": "Why this area was suggested"
        },
        "exercise_hint": {
          "type": "string",
          "description": "Optional exercise suggestion"
        }
      }
    },

    "groove_score": {
      "type": "object",
      "additionalProperties": false,
      "description": "Composite groove score (for UI display only, not interpretive)",
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall groove score 0-100"
        },
        "trend": {
          "type": "string",
          "enum": ["improving", "stable", "needs_attention"],
          "description": "Trend indicator"
        }
      }
    }
  }
}
